PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local fallback)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_resume_builder?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai_resume_builder

# JWT Secret Key for token signing
JWT_SECRET=ai_resume_builder_jwt_super_secret_key_2026
JWT_EXPIRES_IN=30d

# Google Gemini API Key (Keep strictly on the backend!)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
